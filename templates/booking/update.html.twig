{% extends 'base.html.twig' %}

{% block title %}Update Booking{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Update Booking</h1>

        {{ form_start(form) }}
            <div class="row">
                <div class="col-md-6">
                    <h3>Flight Details</h3>
                    {{ form_row(form.flight) }}
                    
                    <h3>Hotel Details</h3>
                    {{ form_row(form.hotel) }}
                </div>
                <div class="col-md-6">
                    <h3>Transport Details</h3>
                    {{ form_row(form.transport) }}
                    
                    <h3>Conference Location</h3>
                    {{ form_row(form.conferenceLocation) }}
                </div>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Update Booking</button>
                <a href="{{ path('app_booking_list') }}" class="btn btn-secondary">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}